{
  "id": "ev-routing-creta",
  "name": "EV routing (Creta)",
  "version": "1.0.5",
  "hmgapi": ">=1.0.1",
  "authors": [
    "sirishant"
  ],
  "repo": "https://github.com/sirishant/egmp-aa-ev-feat",
  "description": "Creta Electric India only. Battery on arrival and charging stops in Google Maps, and EV logs to USB.",
  "system": {
    "model": [
      "SU2IEV"
    ],
    "region": "IND",
    "firmware": "260430"
  },
  "requires": [
    "wireless-carplay-aa ^2.2"
  ],
  "projection": {
    "aa_sensors": {
      "add": [
        23,
        6,
        5
      ]
    },
    "aa_fuel_types": [
      10
    ],
    "aa_ev_connectors": [
      5,
      2
    ]
  },
  "usb": [
    "egmp-aa-ev-logs"
  ],
  "services": [
    {
      "name": "evlog-offload",
      "script": "svc/evlog-offload.sh",
      "user": "root"
    }
  ],
  "logs": {
    "tags": [
      "EvModelSender",
      "EvDriveLog",
      "EvCar"
    ]
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "hmgapi.mods.evcreta.EvRouting",
    "points": {
      "gpm.sensor_source.init": "observe",
      "gpm.receiver.destroy": "observe",
      "gpm.receiver_service.disconnected": "observe"
    },
    "native": {
      "libautoreceiver_infobank.so": [
        "recipes/ev-sensors-48ee793a.recipe"
      ]
    }
  }
}
